# Copy to .env.local and fill in. Supabase dashboard: Project Settings -> API.
SUPABASE_URL=
# The publishable (anon) key. Safe for public reads because RLS limits access.
SUPABASE_PUBLISHABLE_KEY=

# WeatherAPI.com key (https://www.weatherapi.com/my/). Server-only.
WEATHER_API_KEY=

# Resend API key (https://resend.com/api-keys). Server-only. Without it,
# emails are skipped and logged; applications still succeed.
RESEND_API_KEY=
# Optional From address, e.g. The Garden <hr@yourdomain.com>. Needs a domain
# verified in Resend. Leave blank to use Resend's sandbox sender, which only
# delivers to the email address of your Resend account.
EMAIL_FROM=
# The site's public address, e.g. https://thegarden.example (http://localhost:3000
# while developing). Emails use it for the logo and links; without it they go out
# with no logo and no button. Mail clients can't load a localhost logo.
SITE_URL=

# Newsletter ("what does evil mean to you?"). CRON_SECRET guards
# /api/cron/newsletter: use a random string of 16+ characters, and set the same
# value in Vercel and as a GitHub Actions secret (also add SITE_URL there).
# Without it the route refuses every request.
CRON_SECRET=
# While testing, the newsletter goes to this one address only; leave blank to
# send to nobody. With the sandbox sender it must be your Resend account email.
NEWSLETTER_TEST_RECIPIENT=
