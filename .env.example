# Copy to .env.local and fill in. Supabase dashboard: Project Settings -> API.
SUPABASE_URL=
# The publishable (anon) key. Safe for public reads because RLS limits access.
SUPABASE_PUBLISHABLE_KEY=

# WeatherAPI.com key (https://www.weatherapi.com/my/). Server-only.
WEATHER_API_KEY=

# Resend API key (https://resend.com/api-keys). Server-only. Without it,
# emails are skipped and logged; applications still succeed.
RESEND_API_KEY=
# Optional From address, e.g. The Garden <hr@yourdomain.com>. Needs a domain
# verified in Resend. Leave blank to use Resend's sandbox sender, which only
# delivers to the email address of your Resend account.
EMAIL_FROM=
