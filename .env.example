# Copy to .env.local and fill in. Supabase dashboard: Project Settings -> API.
SUPABASE_URL=
# The publishable (anon) key. Safe for public reads because RLS limits access.
SUPABASE_PUBLISHABLE_KEY=

# WeatherAPI.com key (https://www.weatherapi.com/my/). Server-only.
WEATHER_API_KEY=

# Anthropic API key (https://console.anthropic.com/) for the HR chatbot. Server-only.
ANTHROPIC_API_KEY=

# Voyage AI key (https://dashboard.voyageai.com/) for HR chatbot embeddings. Server-only.
VOYAGE_API_KEY=
# Supabase secret / service-role key (Project Settings -> API). ONLY for `npm run ingest`,
# which fills the hr_chunks table. The app never uses it. Never commit or expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: set to "off" to send every HR doc in full instead of using vector search.
# HR_RETRIEVAL=off
